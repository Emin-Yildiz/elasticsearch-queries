						{
							"name": "Create User Connector",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\r\n  \"name\": \"user-db-connector\",\r\n  \"config\": {\r\n    \"connector.class\": \"io.debezium.connector.postgresql.PostgresConnector\",\r\n    \"tasks.max\": \"1\",\r\n    \"database.history.kafka.bootstrap.servers\": \"kafka:29092\",\r\n    \"database.history.kafka.topic\": \"schema-changes.user\",\r\n    \"database.hostname\": \"postgres-service\",\r\n    \"database.port\": \"5432\",\r\n    \"database.user\": \"root\",\r\n    \"database.password\": \"root\",\r\n    \"database.dbname\": \"db\",\r\n    \"database.server.name\": \"users\",\r\n    \"table.include.list\": \"public.users,public.roles\",\r\n    \"key.converter.schemas.enable\": \"false\",\r\n    \"value.converter.schemas.enable\": \"false\",\r\n    \"key.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\r\n    \"value.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\r\n    \"plugin.name\": \"pgoutput\",\r\n    \"slot.name\": \"pdf_slot\",\r\n    \"topic.prefix\": \"example\",\r\n    \"decimal.handling.mode\": \"double\",\r\n    \"tombstone.on.delete\": \"true\",\r\n    \"time.precision.mode\": \"connect\"\r\n  }\r\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "http://localhost:8089/connectors",
									"protocol": "http",
									"host": [
										"localhost"
									],
									"port": "8089",
									"path": [
										"connectors"
									]
								}
							},
							"response": []
						},
						{
							"name": "Delete Connector",
							"request": {
								"method": "DELETE",
								"header": [],
								"url": {
									"raw": "http://localhost:8089/connectors/{connector-name}",
									"protocol": "http",
									"host": [
										"localhost"
									],
									"port": "8089",
									"path": [
										"connectors",
										"{connector-name}"
									]
								}
							},
							"response": []
						}
					]
				},
				{
					"name": "Debezium To Elastic Connector",
					"item": [
